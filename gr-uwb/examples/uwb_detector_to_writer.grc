options:
  parameters:
    author: UWB GNU Radio Project
    category: UWB
    cmake_opt: ''
    comment: Generic energy/coarse/fine packet detector and SC16 writer
    copyright: ''
    description: Detect packets from a CF32 file and write only captured packets.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: uwb_detector_to_writer
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: UWB Detector to Writer
    window_size: ''
  states: {coordinate: [8, 8], rotation: 0, state: enabled}
blocks:
- name: input_file
  id: parameter
  parameters: {alias: '', comment: '', hide: none, label: Input CF32 file, short_id: '', type: str, value: "'testdata/uwb_code9_preamble64_payload128_standard_sfd.cfile'"}
  states: {coordinate: [16, 80], rotation: 0, state: enabled}
- name: template_file
  id: parameter
  parameters: {alias: '', comment: '', hide: none, label: Preamble template, short_id: '', type: str, value: "'testdata/reference_preamble.bin'"}
  states: {coordinate: [16, 144], rotation: 0, state: enabled}
- name: output_dir
  id: parameter
  parameters: {alias: '', comment: '', hide: none, label: Output directory, short_id: '', type: str, value: "'/tmp/uwb-detector-capture'"}
  states: {coordinate: [16, 208], rotation: 0, state: enabled}
- name: input_samples
  id: variable
  parameters: {comment: Exact samples in the default finite test file, value: '5248448'}
  states: {coordinate: [16, 272], rotation: 0, state: enabled}
- name: tail_samples
  id: variable
  parameters: {comment: Silence to close the final energy Region, value: '5000'}
  states: {coordinate: [16, 336], rotation: 0, state: enabled}
- name: blocks_file_source_0
  id: blocks_file_source
  parameters: {begin_tag: pmt.PMT_NIL, file: input_file, length: '0', offset: '0', repeat: 'False', type: complex, vlen: '1'}
  states: {coordinate: [240, 96], rotation: 0, state: enabled}
- name: uwb_detector_0
  id: uwb_detector
  parameters: {capture_samples: '200000', coarse_decimation: '4', energy_gate_decimation: '100', energy_threshold: '0.001', template_file: template_file, pre_trigger: '2032'}
  states: {coordinate: [480, 96], rotation: 0, state: enabled}
- name: blocks_vector_source_x_0
  id: blocks_vector_source_x
  parameters: {repeat: 'False', tags: '[]', type: complex, vector: '(0j,)*tail_samples', vlen: '1'}
  states: {coordinate: [240, 192], rotation: 0, state: enabled}
- name: blocks_stream_mux_0
  id: blocks_stream_mux
  parameters: {lengths: '(input_samples, tail_samples)', num_inputs: '2', type: complex, vlen: '1'}
  states: {coordinate: [400, 144], rotation: 0, state: enabled}
- name: uwb_packet_writer_0
  id: uwb_packet_writer
  parameters: {base_name: capture, directory: output_dir, one_file_per_packet: 'False'}
  states: {coordinate: [752, 96], rotation: 0, state: enabled}
connections:
- [blocks_file_source_0, '0', blocks_stream_mux_0, '0']
- [blocks_vector_source_x_0, '0', blocks_stream_mux_0, '1']
- [blocks_stream_mux_0, '0', uwb_detector_0, '0']
- [uwb_detector_0, packet, uwb_packet_writer_0, packet]
metadata: {file_format: 1}
