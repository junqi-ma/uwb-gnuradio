options:
  parameters:
    alias: ''
    author: UWB GNU Radio Project
    catch_exceptions: 'True'
    comment: Generic energy/coarse/fine packet detector and SC16 writer
    copyright: ''
    description: Detect packets from a CF32 file and write only captured packets.
    gen_linking: dynamic
    generate_options: no_gui
    generator_class_name: PythonNoGuiGenerator
    generator_module: gnuradio.grc.workflows.python_nogui
    hier_block_src_path: '.:'
    id: uwb_detector_to_writer
    max_nouts: '0'
    output_language: python
    realtime_scheduling: ''
    run_command: '{python} -u {filename}'
    run_options: run
    thread_safe_setters: ''
    title: UWB Detector to Writer
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: input_samples
  id: variable
  parameters:
    comment: Exact samples in the default finite test file
    value: '5248448'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [768, 36.0]
    rotation: 0
    state: enabled
- name: tail_samples
  id: variable
  parameters:
    comment: Silence to close the final energy Region
    value: '5000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1008, 36.0]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: ''
    file: input_file
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [384, 188.0]
    rotation: 0
    state: enabled
- name: blocks_stream_mux_0
  id: blocks_stream_mux
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    lengths: (input_samples, tail_samples)
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 248.0]
    rotation: 0
    state: enabled
- name: blocks_vector_source_x_0
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: complex
    vector: (0j,)*tail_samples
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 316.0]
    rotation: 0
    state: enabled
- name: input_file
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Input CF32 file
    short_id: ''
    type: str
    value: '''testdata/uwb_code9_preamble64_payload128_standard_sfd.cfile'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [224, 20.0]
    rotation: 0
    state: enabled
- name: output_dir
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Output directory
    short_id: ''
    type: str
    value: '''/tmp/uwb-detector-capture'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 20.0]
    rotation: 0
    state: enabled
- name: template_file
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Preamble template
    short_id: ''
    type: str
    value: '''testdata/reference_preamble.bin'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 20.0]
    rotation: 0
    state: enabled
- name: uwb_detector_0
  id: uwb_detector
  parameters:
    affinity: ''
    alias: ''
    capture_samples: '200000'
    coarse_decimation: '4'
    coarse_margin: '16'
    coarse_repetitions: '1'
    comment: ''
    energy_gate_decimation: '100'
    energy_threshold: '0.001'
    maxoutbuf: '0'
    minoutbuf: '0'
    pre_trigger: '2032'
    sample_rate: 998.4e6
    template_file: template_file
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 308.0]
    rotation: 0
    state: enabled
- name: uwb_packet_writer_0
  id: uwb_packet_writer
  parameters:
    affinity: ''
    alias: ''
    base_name: capture
    comment: ''
    directory: output_dir
    one_file_per_packet: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1384, 348.0]
    rotation: 0
    state: enabled

connections:
- [blocks_file_source_0, '0', blocks_stream_mux_0, '0']
- [blocks_stream_mux_0, '0', uwb_detector_0, '0']
- [blocks_vector_source_x_0, '0', blocks_stream_mux_0, '1']
- [uwb_detector_0, packet, uwb_packet_writer_0, packet]

metadata:
  file_format: 1
  grc_version: 3.10.12.0
