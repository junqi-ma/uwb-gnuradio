options:
  parameters:
    alias: ''
    author: UWB GNU Radio Project
    catch_exceptions: 'True'
    comment: X410 737.28M -> RFNoC 65/48 -> host 998.4M
    copyright: ''
    description: X410 RFNoC SC16 energy-gated packet detector.
    gen_linking: dynamic
    generate_options: no_gui
    generator_class_name: PythonNoGuiGenerator
    generator_module: gnuradio.grc.workflows.python_nogui
    hier_block_src_path: '.:'
    id: x410_rfnoc_uwb_detector_sc16
    max_nouts: '0'
    output_language: python
    realtime_scheduling: ''
    run_command: '{python} -u {filename}'
    run_options: prompt
    thread_safe_setters: ''
    title: X410 RFNoC UWB SC16 Detector
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: radio_rate
  id: variable
  parameters:
    comment: X410 FPGA radio rate
    value: 737.28e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 80]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: RFNoC upsampler output / host rate
    value: 998.4e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 144]
    rotation: 0
    state: enabled
- name: uhd_rfnoc_graph_0
  id: uhd_rfnoc_graph
  parameters:
    alias: ''
    clock_source: ''
    comment: ''
    dev_addr: '"addr=192.168.10.2"'
    dev_args: '""'
    num_mboards: '1'
    time_source: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [256, 32]
    rotation: 0
    state: enabled
- name: output_dir
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Output directory
    short_id: ''
    type: str
    value: '''/data/uwb_capture'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 208]
    rotation: 0
    state: enabled
- name: uhd_rfnoc_rx_radio_0
  id: uhd_rfnoc_rx_radio
  parameters:
    affinity: ''
    agc: Default
    alias: ''
    antenna: RX2
    bandwidth: '0'
    block_args: '""'
    comment: ''
    dc_offset: 'False'
    device_select: '0'
    frequency: 1e9
    gain: '0'
    instance_index: '0'
    iq_balance: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_chans: '1'
    rate: radio_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [256, 128]
    rotation: 0
    state: enabled
- name: uhd_rfnoc_rx_streamer_0
  id: uhd_rfnoc_rx_streamer
  parameters:
    adapter_id_list: '[0]'
    affinity: ''
    alias: ''
    args: ''
    comment: ''
    issue_stream_cmd: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_chans: '1'
    otw: sc16
    output_type: sc16
    start_time: '0'
    start_time_set: 'False'
    use_default_adapter_id: 'True'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [768, 128]
    rotation: 0
    state: enabled
- name: uwb_detector_sc16_0
  id: uwb_detector_sc16
  parameters:
    affinity: ''
    alias: ''
    capture_samples: '200000'
    coarse_decimation: '4'
    coarse_margin: '16'
    coarse_repetitions: '1'
    comment: ''
    energy_gate_decimation: '100'
    energy_threshold: '0.001'
    maxoutbuf: '0'
    minoutbuf: '0'
    pre_trigger: '2032'
    sample_rate: 998.4e6
    template_file: '"testdata/reference_preamble.bin"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1024, 128]
    rotation: 0
    state: enabled
- name: uwb_packet_writer_0
  id: uwb_packet_writer
  parameters:
    affinity: ''
    alias: ''
    base_name: capture
    comment: ''
    directory: output_dir
    one_file_per_packet: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1280, 128]
    rotation: 0
    state: enabled
- name: uwb_rfnoc_upsampler_0
  id: uwb_rfnoc_upsampler
  parameters:
    affinity: ''
    alias: ''
    block_args: '""'
    block_type: '"Upsampler"'
    comment: ''
    device_select: '0'
    input_rate: radio_rate
    instance_index: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    output_rate: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [512, 128]
    rotation: 0
    state: enabled

connections:
- [uhd_rfnoc_rx_radio_0, '0', uwb_rfnoc_upsampler_0, '0']
- [uhd_rfnoc_rx_streamer_0, '0', uwb_detector_sc16_0, '0']
- [uwb_detector_sc16_0, packet, uwb_packet_writer_0, packet]
- [uwb_rfnoc_upsampler_0, '0', uhd_rfnoc_rx_streamer_0, '0']

metadata:
  file_format: 2
  grc_version: 3.10.12.0
