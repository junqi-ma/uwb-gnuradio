# Native (GNU-Radio-free) package configuration for the gr-uwb core.
#
# Installed by a UWB_BUILD_GNURADIO=OFF build as
#   <prefix>/<libdir>/cmake/uwb/uwbConfig.cmake
# and deliberately does NOT find_package(Gnuradio): the uwb::uwb_core /
# uwb::uwb_native targets link only the C++ standard library, VOLK, Threads
# and (when built with UHD) UHD.
#
# Usage:
#   find_package(uwb CONFIG REQUIRED)
#   target_link_libraries(app PRIVATE uwb::uwb_native)

include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(Volk)
# TRUE unless the UHD dependency of a UHD-enabled build could not be closed
# (then uwbConfigUhdDep.cmake has already set uwb_FOUND FALSE and the
# uwbTargets include below is skipped).
set(UWB_UHD_DEP_OK TRUE)
@UWB_CONFIG_UHD_DEP@
if(UWB_UHD_DEP_OK)
    include("${CMAKE_CURRENT_LIST_DIR}/uwbTargets.cmake")
endif()
