# LEGACY package name: find_package(uwb CONFIG REQUIRED).
#
# Phase 3 made `OpenUWB` the project and `openuwb::*` the exported targets.
# Existing consumers still call find_package(uwb) and link uwb::uwb_native /
# uwb::uwb_core / uwb::uwb_twr_core, so this config replays the same
# dependency closure over the SAME target file and then re-creates the old
# target spellings as thin INTERFACE IMPORTED aliases.
#
# It is installed next to the primary package:
#   <prefix>/<libdir>/cmake/uwb/uwbConfig.cmake
#   <prefix>/<libdir>/cmake/OpenUWB/OpenUWBConfig.cmake
# so the relative include below stays relocatable.
#
# TODO(openuwb-compat-removal): delete this package once downstream projects
# use find_package(OpenUWB) and the openuwb:: target names.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(Volk)
set(OPENUWB_UHD_DEP_OK TRUE)
# Only a UHD-enabled build carries the UHD dependency; on a no-UHD build the
# exported targets reference no UHD::UHD, so requiring UHD here made the legacy
# package report not-found on every machine without UHD.  Mirrors the primary
# OpenUWBConfig.cmake (same @OPENUWB_CONFIG_UHD_DEP@ substitution).
@OPENUWB_CONFIG_UHD_DEP@
if(NOT OPENUWB_UHD_DEP_OK)
    set(uwb_FOUND FALSE)
    set(uwb_NOT_FOUND_MESSAGE "${OpenUWB_NOT_FOUND_MESSAGE}")
    return()
endif()

if(NOT TARGET openuwb::uwb_native)
    include("${CMAKE_CURRENT_LIST_DIR}/../OpenUWB/OpenUWBTargets.cmake")
endif()

# TODO(openuwb-compat-removal): legacy target names.  Each one forwards to the
# real imported target, so there is exactly one set of link interfaces.
foreach(_uwb_legacy_pair
        "uwb_core;uwb_core"
        "uwb_native;uwb_native"
        "uwb_twr_core;twr_core"
        "uwb_twr_phy;twr_phy")
    list(GET _uwb_legacy_pair 0 _uwb_old)
    list(GET _uwb_legacy_pair 1 _uwb_new)
    if(NOT TARGET uwb::${_uwb_old})
        add_library(uwb::${_uwb_old} INTERFACE IMPORTED)
        set_target_properties(uwb::${_uwb_old} PROPERTIES
            INTERFACE_LINK_LIBRARIES openuwb::${_uwb_new})
    endif()
endforeach()

set(uwb_FOUND TRUE)
